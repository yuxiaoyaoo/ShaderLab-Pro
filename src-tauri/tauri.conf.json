{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ShaderLab Pro",
  "version": "0.1.0",
  "identifier": "com.shaderlabpro.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app", "dmg", "appimage", "deb", "rpm"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFCQTRGMUQ1MURBRDZFMUYKUldRZmJxMGQxZkdrR3pZcnFZdnpFQlpIWVFhdldLVUlUc2tnM3RMeUx0OHoveHliS2MwWnFQTHMK",
      "endpoints": [
        "https://github.com/yuxiaoyaoo/ShaderLab-Pro/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
